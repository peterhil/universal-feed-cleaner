{
  "name": "universal-feed-cleaner",
  "description": "Hide social media and other feed contents by keywords to have some peace of mind.",
  "version": "0.1",
  "type": "module",
  "author": "Peter Hillerström <peter.hillerstrom@gmail.com>",
  "license": "MPL-2.0",
  "scripts": {
    "rollup:build": "rm -rf dist/* && NODE_ENV=production rollup -c",
    "rollup": "rm -rf dev/* && NODE_ENV=development rollup -cw",

    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@babel/core": "^7.11.0",
    "@babel/eslint-parser": "^7.23.3",
    "@rollup/plugin-alias": "^5.1.0",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-eslint": "^9.0.5",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "eslint": "^8.56.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-n": "^15.0.0 || ^16.0.0",
    "eslint-plugin-promise": "^6.0.0",
    "rollup": "^4.22.4",
    "rollup-plugin-copy": "^3.5.0",

    "@tsconfig/svelte": "^5.0.4",
    "@types/chrome": "^0.0.280",
    "@wxt-dev/module-svelte": "^2.0.0",
    "svelte": "^5.1.16",
    "svelte-check": "^4.0.7",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3",
    "wxt": "^0.19.29"
  },
  "dependencies": {
    "escape-string-regexp": "^5.0.0",
    "rambdax": "^11.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "dtrace-provider",
      "esbuild",
      "spawn-sync"
    ]
  }
}
